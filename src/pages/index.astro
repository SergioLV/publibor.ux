  .hero-ctas {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (min-width: 480px) {
    .hero-ctas {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  .hero .btn-secondary {
    color: var(--white);
    border-color: rgba(255,255,255,0.15);
  }
  .hero .btn-secondary:hover { border-color: rgba(255,255,255,0.35); }

  .hero-whatsapp {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    padding: 0.95rem 1.8rem;
    min-height: 48px;
    text-decoration: none;
    text-transform: uppercase;
    border-radius: 6px;
    background: #25d366;
