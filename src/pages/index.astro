    display: block;
    height: 1.1em;
    overflow: hidden;
    position: relative;
  }

  .rotating-words {
    display: block;
    animation: rotate-words 6s infinite;
  }

  .rotating-word {
    display: block;
    height: 1.1em;
    line-height: 1.1;
    color: var(--gold);
  }

  @keyframes rotate-words {
    0%, 26% { transform: translateY(0); }
    33%, 59% { transform: translateY(-1.1em); }
    66%, 92% { transform: translateY(-2.2em); }
    100% { transform: translateY(0); }
  }

  .hero-sub {
    margin-top: 1.25rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--gray-400);
    max-width: 440px;
