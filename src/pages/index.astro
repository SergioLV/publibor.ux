    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1.2rem;
  }

  /* ── Announcement bar ── */
  .announce-bar {
    background: var(--gold);
    padding: 0.5rem 0;
    position: relative;
    z-index: 20;
  }

  .announce-inner {
    text-align: center;
  }

  .announce-bar p {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
