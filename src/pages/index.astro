  /* ── Solutions Grid ── */
  .solutions {
    padding: var(--py) 0;
    background: #0a0a0a;
    position: relative;
    overflow: hidden;
  }

  .solutions::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
