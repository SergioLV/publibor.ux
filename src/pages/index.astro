---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Publibor — Bordado, DTF y producción textil"
  description="Proveedor textil para marcas, empresas y revendedores. Bordado, DTF, texturizado y producción recurrente con respuesta comercial y cumplimiento."
>
  <!-- Announcement bar -->
  <div class="announce-bar">
    <div class="container announce-inner">
      <p>Cotizaciones respondidas en menos de 1 hora — <a href="https://wa.me/56956791655" target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp</a></p>
    </div>
  </div>

  <!-- Header -->
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand" aria-label="PubliborChile">
        <img src="/pb_logo.svg" alt="PubliborChile" class="brand-icon" decoding="async" />
      </a>
      <nav class="header-nav">
        <a href="#servicios" class="nav-link">Servicios</a>
        <a href="#contacto" class="nav-link">Contacto</a>
        <a href="#contacto" class="header-cta">Cotizar pedido</a>
      </nav>
    </div>
  </header>

  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-content">
        <p class="eyebrow">Bordado · DTF · Corte láser</p>
        <h1>
          Producción textil para marcas y empresas.
          <span class="rotating-wrapper">
            <span class="rotating-words" aria-label="DTF, Texturizado, Bordados">
              <span class="rotating-word">DTF.</span>
              <span class="rotating-word">Texturizado.</span>
              <span class="rotating-word">Bordados.</span>
            </span>
          </span>
        </h1>
        <p class="hero-sub">
          5.000+ pedidos producidos para distribuidores, confeccionistas y empresas.
        </p>
        <div class="hero-ctas">
          <a href="#contacto" class="btn-primary">Cotizar pedido</a>
          <a href="https://wa.me/56956791655" target="_blank" rel="noopener noreferrer" class="hero-whatsapp">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Contáctanos
          </a>
        </div>
      </div>
      <div class="hero-video">
        <video id="heroVid1" muted playsinline disablepictureinpicture preload="auto">
          <source src="/dtf/embroidery_clip.webm" type="video/webm" />
        </video>
        <video id="heroVid2" muted playsinline disablepictureinpicture preload="none">
          <source src="/dtf/dtf_clip.webm" type="video/webm" />
        </video>
        <video id="heroVid3" muted playsinline disablepictureinpicture preload="none">
          <source src="/dtf/laser_clip.webm" type="video/webm" />
        </video>
      </div>
    </div>
  </section>

  <!-- Logos -->
  <section class="logos">
    <div class="logos-top">
      <div class="container">
        <p class="logos-label">Marcas que producimos para nuestros clientes</p>
      </div>
    </div>
    <div class="marquee" aria-label="Logos de clientes">
      <div class="marquee-track">
        <img src="/logos/tesla.webp" alt="Tesla" loading="lazy" />
        <img src="/logos/aws.webp" alt="AWS" loading="lazy" />
        <img src="/logos/scania.webp" alt="Scania" loading="lazy" />
        <img src="/logos/ecocopter.webp" alt="Ecocopter" loading="lazy" />
        <img src="/logos/fach.svg" alt="FACH" loading="lazy" />
        <img src="/logos/udd.webp" alt="UDD" loading="lazy" />
        <img src="/logos/unab.webp" alt="UNAB" loading="lazy" />
        <img src="/logos/kami_sushi.webp" alt="Kami Sushi" loading="lazy" />
        <!-- duplicate for seamless loop -->
        <img src="/logos/tesla.webp" alt="" aria-hidden="true" loading="lazy" />
        <img src="/logos/aws.webp" alt="" aria-hidden="true" loading="lazy" />
        <img src="/logos/scania.webp" alt="" aria-hidden="true" loading="lazy" />
        <img src="/logos/ecocopter.webp" alt="" aria-hidden="true" loading="lazy" />
        <img src="/logos/fach.svg" alt="" aria-hidden="true" loading="lazy" />
        <img src="/logos/udd.webp" alt="" aria-hidden="true" loading="lazy" />
        <img src="/logos/unab.webp" alt="" aria-hidden="true" loading="lazy" />
        <img src="/logos/kami_sushi.webp" alt="" aria-hidden="true" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Bento: Services -->
  <section class="bento">
    <div class="bento-grid">
      <!-- Row 1: DTF (60%) + Bordado (40%) -->
      <article class="bento-card bento-card--dtf">
        <img src="/images/dtfam.jpg" alt="DTF Industrial" loading="eager" fetchpriority="high" />
        <div class="bento-card-content">
          <span class="bento-label">Servicio principal</span>
          <h3>DTF Industrial de Alto Metraje</h3>
          <p>Impresión directa en film para poleras, polerones y bolsas. Alta definición, colores firmes, volumen real.</p>
        </div>
      </article>
      <article class="bento-card bento-card--bordado">
        <img src="/images/bordadora.jpg" alt="Bordado multicabezal" loading="lazy" />
        <div class="bento-card-content">
          <span class="bento-label">Servicio principal</span>
          <h3>Bordado Multicabezal</h3>
          <p>Máquinas multicabezal para uniformes, merchandising e institucional. Consistencia entre corridas.</p>
        </div>
      </article>
      <!-- Row 2: Láser + Sublimación + Especiales -->
      <article class="bento-card bento-card--sm">
        <img src="/images/laser.jpg" alt="Corte láser" loading="lazy" />
        <div class="bento-card-content">
          <h3>Corte Láser</h3>
          <p>Terminación limpia y profesional</p>
        </div>
      </article>
      <article class="bento-card bento-card--sm">
        <img src="/images/sublimacion.jpg" alt="Sublimación" loading="lazy" />
        <div class="bento-card-content">
          <h3>Sublimación</h3>
          <p>Full color en poliéster y sintéticos</p>
        </div>
      </article>
      <article class="bento-card bento-card--sm">
        <img src="/images/calandra.jpg" alt="Especiales" loading="lazy" />
        <div class="bento-card-content">
          <h3>Especiales</h3>
          <p>Calandra, UV, texturizado y técnicas mixtas</p>
        </div>
      </article>
    </div>
  </section>

  <!-- Industry Solutions -->
  <section class="solutions">
    <div class="solutions-glow"></div>
    <div class="container">
      <div class="solutions-header">
        <h2>Tipos de Pedido y Producción</h2>
        <p>Adaptamos la línea según el volumen, la técnica y la frecuencia de tu negocio.</p>
      </div>
      <div class="solutions-grid">
        <!-- Card 1: Deporte (HERO - 60%) -->
        <a href="#contacto" class="solution-card solution-card--hero" data-tipo="deportiva">
          <video class="solution-bg-video" muted loop playsinline disablepictureinpicture preload="none">
            <source data-src="/dtf/dtf_clip.webm" type="video/webm" />
          </video>
          <div class="solution-card-inner">
            <span class="solution-tag">01 // DEPORTE Y LIGAS</span>
            <h3>Equipos y Clubes</h3>
            <p class="solution-body">DTF de alto tráfico para números, nombres y escudos. Estampados de alta durabilidad para lavado intensivo y reposición continua sin quiebre de stock. Trabajamos con distribuidores deportivos, clubes, ligas y marcas de indumentaria.</p>
          </div>
          <svg class="solution-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
        </a>
        <!-- Card 2: Uniformes -->
        <a href="#contacto" class="solution-card" data-tipo="corporativa">
          <span class="solution-tag">02 // INDUSTRIAL</span>
          <h3>Uniformes de Trabajo</h3>
          <p class="solution-body">Bordado multicabezal en parkas, jockeys y gabardina. Consistencia garantizada en tirajes masivos.</p>
          <svg class="solution-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
        </a>
        <!-- Card 3: Retail -->
        <a href="#contacto" class="solution-card" data-tipo="retail">
          <span class="solution-tag">03 // RETAIL</span>
          <h3>Marcas de Ropa</h3>
          <p class="solution-body">Producción recurrente para colecciones. DTF, bordado y acabados especiales (láser, UV, texturizado).</p>
          <svg class="solution-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
        </a>
        <!-- Card 4: Agencias -->
        <a href="#contacto" class="solution-card" data-tipo="agencias">
          <span class="solution-tag">04 // AGENCIAS</span>
          <h3>Eventos y Campañas</h3>
          <p class="solution-body">Respuestas rápidas para plazos estrictos. Operación marca blanca y gestión multitécnica en una orden.</p>
          <svg class="solution-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Production Floor (COMMENTED OUT)
  <section id="servicios" class="floor">
    <div class="floor-header">
      <div class="container">
        <p class="eyebrow">Servicios y tipos de pedido</p>
        <h2>Producción según el tipo de pedido.</h2>
        <p class="floor-sub">Ajustamos producción y continuidad según el tipo de cliente, uso final y frecuencia del pedido.</p>
      </div>
    </div>
    <div class="floor-mosaic">
      <article class="tile tile--lg">
        <img src="/dtf_image.jpg" alt="DTF" loading="lazy" decoding="async" />
        <div class="tile-overlay">
          <span class="tile-label">Servicio</span>
          <h3>DTF</h3>
          <p>Impresión directa con plotter DTF sobre poleras, polerones y bolsas. Alta definición y colores firmes.</p>
        </div>
      </article>
      <article class="tile tile--lg">
        <img src="/embroidery_image.jpg" alt="Bordado y corte láser" loading="lazy" decoding="async" />
        <div class="tile-overlay">
          <span class="tile-label">Servicio</span>
          <h3>Bordado y corte láser</h3>
          <p>Bordado para uniformes y merchandising. Corte láser para un terminado limpio y profesional.</p>
        </div>
      </article>
      <article class="tile tile--sm">
        <img src="/images/ropa_deportiva.png" alt="Equipos y deporte" loading="lazy" decoding="async" />
        <div class="tile-overlay">
          <span class="tile-label">Tipo de pedido</span>
          <h3>Equipos y deporte</h3>
          <p>Series para clubes, academias, torneos y eventos.</p>
        </div>
      </article>
      <article class="tile tile--sm">
        <img src="/images/ropa_trabajo.png" alt="Uniformes de trabajo" loading="lazy" decoding="async" />
        <div class="tile-overlay">
          <span class="tile-label">Tipo de pedido</span>
          <h3>Uniformes de trabajo</h3>
          <p>Prendas para operación diaria, atención y terreno.</p>
        </div>
      </article>
      <article class="tile tile--sm">
        <img src="/images/merch.webp" alt="Merch para marcas" loading="lazy" decoding="async" />
        <div class="tile-overlay">
          <span class="tile-label">Tipo de pedido</span>
          <h3>Merch para marcas</h3>
          <p>Textil para venta, posicionamiento y comunidad.</p>
        </div>
      </article>
      <article class="tile tile--sm">
        <img src="/images/activations.png" alt="Campañas y activaciones" loading="lazy" decoding="async" />
        <div class="tile-overlay">
          <span class="tile-label">Tipo de pedido</span>
          <h3>Campañas y activaciones</h3>
          <p>Producción para acciones promocionales y lanzamientos.</p>
        </div>
      </article>
    </div>
  </section>
  -->

  <!-- Publibor en Datos -->
  <section class="telemetry">
    <div class="container">
      <div class="telemetry-header">
        <span class="telemetry-label">OPERACIÓN Y CAPACIDAD EN DATOS</span>
        <h2>Capacidad industrial respaldada por nuestra propia planta de producción.</h2>
      </div>
      
      <!-- Borderless Ledger -->
      <div class="telemetry-ledger">
        <div class="telemetry-col">
          <span class="telemetry-number" id="live-meters" data-baseline="59976" data-rate="70" data-start="2026-08-05T21:16:19Z">+0 m</span>
          <span class="telemetry-stat-label">METROS PRODUCIDOS (ÚLTIMO SEMESTRE)</span>
          <p class="telemetry-detail">Metros lineales procesados en estampado, texturizado, DTF y textil.</p>
        </div>
        <div class="telemetry-col">
          <span class="telemetry-number" id="live-orders" data-baseline="1095" data-rate="1.2" data-start="2026-08-05T21:16:19Z">0</span>
          <span class="telemetry-stat-label">ÓRDENES PROCESADAS (ÚLTIMO SEMESTRE)</span>
          <p class="telemetry-detail">Volumen total ejecutado y registrado en nuestros ciclos de producción.</p>
        </div>
        <div class="telemetry-col">
          <span class="telemetry-number" id="live-monthly">0</span>
          <span class="telemetry-stat-label">ÓRDENES/MES POR ALGUNOS CLIENTES</span>
          <p class="telemetry-detail">Volumen mensual sostenido por cuentas clave de distribución.</p>
        </div>
      </div>

      <!-- Editorial Statement -->
      <div class="telemetry-editorial">
        <div class="telemetry-editorial-item">
          <h3>Todo en un solo lugar</h3>
          <p>Juntamos estampado, bordado, DTF, corte láser y terminaciones para que no tengas que andar coordinando distintos talleres.</p>
        </div>
        <div class="telemetry-editorial-item">
          <h3>Capacidad de respuesta real</h3>
          <p>Maquinaria propia operando de forma continua para seguir el ritmo de tus pedidos sin frenar tu stock.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA + Contact -->
  <section id="contacto" class="contact">
    <!-- Form area -->
    <div class="container">
      <div class="contact-header">
        <p class="eyebrow">Contacto</p>
        <h2>Hablemos de tu próximo pedido.</h2>
        <p class="contact-support">Cuéntanos qué necesitas producir, las cantidades estimadas y los plazos que manejas.</p>
      </div>
      <div class="contact-layout">
        <!-- Form -->
        <form class="contact-form" action="#" method="POST">
          <div class="form-row">
            <div class="form-group">
              <label for="name">Nombre</label>
              <input type="text" id="name" name="name" placeholder="Tu nombre" required />
            </div>
            <div class="form-group">
              <label for="company">Empresa</label>
              <input type="text" id="company" name="company" placeholder="Nombre de tu empresa" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="email">Correo</label>
              <input type="email" id="email" name="email" placeholder="correo@empresa.cl" required />
            </div>
            <div class="form-group">
              <label for="phone">Teléfono</label>
              <input type="tel" id="phone" name="phone" placeholder="+56 9 ..." />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="service">Tipo de servicio</label>
              <select id="service" name="service" required>
                <option value="" disabled selected>Seleccionar</option>
                <option value="dtf">DTF</option>
                <option value="bordado">Bordado</option>
                <option value="corte-laser">Corte láser</option>
                <option value="varios">Varios servicios</option>
                <option value="otro">Otro</option>
              </select>
            </div>
            <div class="form-group">
              <label for="quantity">Cantidad aproximada</label>
              <select id="quantity" name="quantity">
                <option value="" disabled selected>Seleccionar</option>
                <option value="50-100">50 – 100 unidades</option>
                <option value="100-500">100 – 500 unidades</option>
                <option value="500-1000">500 – 1.000 unidades</option>
                <option value="1000+">Más de 1.000 unidades</option>
                <option value="no-se">No estoy seguro</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label for="message">¿Qué necesitas producir?</label>
            <textarea id="message" name="message" rows="3" placeholder="Describe brevemente tu pedido, aplicación y plazos..." required></textarea>
          </div>
          <div class="form-actions">
            <button type="submit" class="btn-primary">Cotizar pedido</button>
            <a href="https://wa.me/56956791655" target="_blank" rel="noopener noreferrer" class="btn-whatsapp">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              WhatsApp
            </a>
          </div>
          <p class="form-hint">Respondemos en menos de 1 hora.</p>
        </form>
        <!-- Map + Info -->
        <div class="contact-side">
          <div class="contact-map">
            <iframe
              src="https://www.google.com/maps?q=Ureta+Cox+233,+San+Joaqu%C3%ADn,+Santiago,+Chile&output=embed"
              width="100%"
              height="240"
              style="border:0;border-radius:12px;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Ubicación Publibor"
            ></iframe>
          </div>
          <div class="contact-info">
            <div class="info-item">
              <strong>DIRECCIÓN</strong>
              <p>Ureta Cox 233, San Joaquín, Santiago</p>
            </div>
            <div class="info-item">
              <strong>HORARIO</strong>
              <p>Lunes a viernes, 8:30 a 18:00</p>
            </div>
            <div class="info-item">
              <strong>CORREO</strong>
              <p><a href="mailto:contacto@publibor.cl">contacto@publibor.cl</a></p>
            </div>
            <div class="info-item">
              <strong>TELÉFONO</strong>
              <p><a href="tel:+56956791655">+56 9 5679 1655</a></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="site-footer">

  <!-- Floating WhatsApp -->
