      padding: 0.95rem 2.2rem;
    }
  }

  /* Hero video */
  .hero-video {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16/9;
  }

  @media (min-width: 820px) {
    .hero-video {
      aspect-ratio: auto;
      align-self: stretch;
