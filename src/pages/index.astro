    justify-content: center;
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    padding: 0.95rem 1.8rem;
    min-height: 48px;
    text-decoration: none;
    text-transform: uppercase;
    border-radius: 6px;
    transition: all 0.2s ease;
