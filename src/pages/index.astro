  /* ── Bento Grid ── */
  .bento {
    background: var(--near-black);
    padding: 2px;
  }

  .bento-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2px;
  }

  @media (min-width: 768px) {
    .bento-grid {
      grid-template-columns: 3fr 2fr;
      grid-template-rows: auto auto;
    }

    .bento-card--dtf {
      grid-column: 1;
      grid-row: 1;
    }

    .bento-card--bordado {
      grid-column: 2;
      grid-row: 1;
    }

    .bento-card--sm {
      grid-column: auto;
    }
