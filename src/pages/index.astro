<script>
  // Hero video rotation
  const vids = [
    document.getElementById("heroVid1") as HTMLVideoElement,
    document.getElementById("heroVid2") as HTMLVideoElement,
    document.getElementById("heroVid3") as HTMLVideoElement,
  ];

  let current = 0;

  function playNext() {
    vids.forEach((v) => v.classList.remove("active"));
    const active = vids[current];
    active.classList.add("active");
    active.currentTime = 0;
    active.play();

    active.onended = () => {
      current = (current + 1) % vids.length;
      playNext();
    };
  }

  playNext();

  // Sticky header on scroll
  const header = document.querySelector('.site-header') as HTMLElement;
  const hero = document.querySelector('.hero') as HTMLElement;
  let lastScroll = 0;
  let heroHeight = hero?.offsetHeight || 600;

  // Show header at top initially
  header?.classList.add('at-top');

  function handleScroll() {
    const currentScroll = window.scrollY;
    
    if (currentScroll <= 50) {
      // At top - show transparent header
      header?.classList.add('at-top');
      header?.classList.remove('visible');
    } else if (currentScroll > heroHeight * 0.5) {
      // Past hero - show sticky header
      header?.classList.remove('at-top');
      
      if (currentScroll < lastScroll || currentScroll > heroHeight) {
        // Scrolling up or past hero - show header
        header?.classList.add('visible');
      } else if (currentScroll > lastScroll && currentScroll > heroHeight * 0.8) {
        // Scrolling down fast - hide header
        header?.classList.remove('visible');
      }
    } else {
      // In hero area - hide sticky
      header?.classList.remove('at-top');
      header?.classList.remove('visible');
    }
    
    lastScroll = currentScroll;
  }

  // Recalculate hero height on resize
  window.addEventListener('resize', () => {
    heroHeight = hero?.offsetHeight || 600;
  });

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll(); // Initial check

  // Solution cards: smooth scroll + pre-fill form
  const solutionCards = document.querySelectorAll('.solution-card');
  const serviceSelect = document.getElementById('service') as HTMLSelectElement;

  const tipoMapping: Record<string, string> = {
    'deportiva': 'dtf',
    'corporativa': 'bordado',
    'retail': 'varios',
    'agencias': 'varios'
  };

  solutionCards.forEach(card => {
    card.addEventListener('click', (e) => {
      e.preventDefault();
      const tipo = (card as HTMLElement).dataset.tipo || '';
      const serviceValue = tipoMapping[tipo] || '';
      
      // Pre-fill form
      if (serviceSelect && serviceValue) {
        serviceSelect.value = serviceValue;
      }
      
      // Smooth scroll to contact
      const contactSection = document.getElementById('contacto');
      contactSection?.scrollIntoView({ behavior: 'smooth' });
    });
  });

  // Live production counters
  function updateLiveCounters() {
    const metersEl = document.getElementById('live-meters');
    const ordersEl = document.getElementById('live-orders');
    
    if (metersEl) {
      const baseline = parseFloat(metersEl.dataset.baseline || '0');
      const rate = parseFloat(metersEl.dataset.rate || '0'); // per hour
      const startDate = new Date(metersEl.dataset.start || '');
      const now = new Date();
      const hoursElapsed = (now.getTime() - startDate.getTime()) / (1000 * 60 * 60);
      const currentMeters = Math.floor(baseline + (hoursElapsed * rate));
      metersEl.dataset.target = currentMeters.toString();
    }
    
    if (ordersEl) {
      const baseline = parseFloat(ordersEl.dataset.baseline || '0');
      const rate = parseFloat(ordersEl.dataset.rate || '0'); // per hour
      const startDate = new Date(ordersEl.dataset.start || '');
      const now = new Date();
      const hoursElapsed = (now.getTime() - startDate.getTime()) / (1000 * 60 * 60);
      const currentOrders = Math.floor(baseline + (hoursElapsed * rate));
      ordersEl.dataset.target = currentOrders.toString();
    }
  }

  // Count-up animation
  function animateCountUp(el: HTMLElement, target: number, suffix: string = '', prefix: string = '') {
    const duration = 2000;
    const steps = 60;
    const stepDuration = duration / steps;
    let current = 0;
    const increment = target / steps;
    
    const timer = setInterval(() => {
      current += increment;
      if (current >= target) {
        current = target;
        clearInterval(timer);
      }
      el.textContent = prefix + Math.floor(current).toLocaleString('es-CL') + suffix;
    }, stepDuration);
  }

  // Intersection Observer to trigger animation when visible
  function setupCountUpObserver() {
    const metersEl = document.getElementById('live-meters');
    const ordersEl = document.getElementById('live-orders');
    const monthlyEl = document.getElementById('live-monthly');
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const target = parseInt(el.dataset.target || '0');
          
          if (el.id === 'live-meters') {
            animateCountUp(el, target, ' m', '+');
          } else if (el.id === 'live-orders') {
            animateCountUp(el, target);
          } else if (el.id === 'live-monthly') {
            animateCountUp(el, 50, '+');
          }
          
          observer.unobserve(el);
        }
      });
    }, { threshold: 0.5 });

    if (metersEl) observer.observe(metersEl);
    if (ordersEl) observer.observe(ordersEl);
    if (monthlyEl) observer.observe(monthlyEl);
  }

  // Initialize
  updateLiveCounters();
  setupCountUpObserver();
  
  // Update targets every minute (for long sessions)
  setInterval(updateLiveCounters, 60000);

  // Lazy load videos below fold
  const lazyVideos = document.querySelectorAll('video[preload="none"]');
  const videoObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const video = entry.target as HTMLVideoElement;
        const source = video.querySelector('source[data-src]') as HTMLSourceElement;
        if (source && source.dataset.src) {
          source.src = source.dataset.src;
          video.load();
          video.play();
        }
        videoObserver.unobserve(video);
      }
    });
  }, { rootMargin: '200px' });

  lazyVideos.forEach(video => videoObserver.observe(video));
</script>
