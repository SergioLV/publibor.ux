  .hero-video video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .hero-video video.active {
    opacity: 1;
  }

  /* ── Positioning ── */
  .positioning {
    padding: var(--py) 0;
    background: var(--white);
