<style>
  :root {
    --gold: #f3c242;
    --black: #000;
    --near-black: #0c0c0c;
    --white: #fff;
    --off-white: #f6f5f3;
    --gray-100: #edeceb;
    --gray-200: #dddcda;
    --gray-400: #a19d98;
    --gray-600: #5c5854;
    --gray-800: #2a2826;
    --font: "Plus Jakarta Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
    --max-w: 1140px;
    --py: clamp(3.5rem, 10vw, 8rem);
